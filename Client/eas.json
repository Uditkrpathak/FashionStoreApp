      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://fashion-gateway-n7lq.onrender.com/api/v1",
        "EXPO_PUBLIC_RAZORPAY_KEY_ID": "YOUR_RAZORPAY_KEY_ID"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://fashion-gateway-n7lq.onrender.com/api/v1",
        "EXPO_PUBLIC_RAZORPAY_KEY_ID": "YOUR_RAZORPAY_KEY_ID"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
